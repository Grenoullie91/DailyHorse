{
  "manifest_version": 3,
  "name": "Haas Arts Daily Workhorse",
  "version": "1.0.0",
  "description": "Local DailyHorse dashboard and browser workspace navigator.",
  "permissions": ["sidePanel", "storage", "tabs"],
  "action": { "default_title": "DailyHorse Workspace" },
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "chrome_url_overrides": { "newtab": "newtab.html" }
}
