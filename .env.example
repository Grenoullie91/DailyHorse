# Network
PORT=4174
HOST=127.0.0.1
DATA_DIR=./data

# Sync cadence in minutes. Individual connectors still respect their own limits.
SYNC_INTERVAL_MINUTES=60

# GitHub (optional). A fine-grained PAT belonging to Grenoullie91, with repository
# metadata/traffic read access. Traffic endpoints require push-level access.
GITHUB_USERNAME=Grenoullie91
GITHUB_TOKEN=

# Google OAuth. Create these in Google Cloud; never expose them to the browser.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Alternative to the two variables above: a local Google OAuth client JSON file.
# The credential file stays outside this project and must never be committed.
GOOGLE_CLIENT_SECRET_FILE=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4174/api/oauth/google/callback
# OAuth access token and optional refresh token, stored locally only. The connector
# will refresh an expired access token when client credentials are also configured.
GOOGLE_ACCESS_TOKEN=
GOOGLE_REFRESH_TOKEN=
# The Google OAuth flow also requests calendar.readonly. Enable Google Calendar API
# in the same Google Cloud project, then reconnect after adding this scope.
GA4_PROPERTY_ID=
SEARCH_CONSOLE_SITE_URL=sc-domain:haasarts.de
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=
PLAY_DEVELOPER_ACCOUNT_ID=
PLAY_SERVICE_ACCOUNT_FILE=
PLAY_PACKAGE_NAMES=

# YouTube OAuth and channel. Channel ID is preferred; handle fallback is optional.
YOUTUBE_CHANNEL_ID=
YOUTUBE_CHANNEL_HANDLE=@haasarts-de

# Meta Instagram Graph API with Facebook Login. Configure this redirect URI in
# the app's Instagram API setup; a professional account linked to a Facebook
# Page is required.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4174/api/oauth/meta/callback

# IONOS IMAP (optional, strictly read-only). Provide a JSON array locally only;
# passwords/app-passwords are secrets and must not be committed. Each account needs
# id, email, password, and may override host (default imap.ionos.com), port (993),
# and tls (true). Example shape: [{"id":"work","email":"name@example.com","password":"..."}]
IONOS_IMAP_ACCOUNTS=
